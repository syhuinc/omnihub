rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, then Publish.
// Restricts every user's synced data (notes, vault, alarms, ...) to that
// signed-in user only — nobody can read or write another user's documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The user's root doc (a different path depth than the wildcard rule above, so it
    // never inherits that rule's write access) is reserved for fields only server-side
    // code should ever set (Admin SDK, which bypasses rules entirely) — nothing here
    // today, but the client can never write to it regardless.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
