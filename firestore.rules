rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, then Publish.
// Restricts every user's synced data (notes, vault, alarms, ...) to that
// signed-in user only — nobody can read or write another user's documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pro entitlement lives on the user's root doc (a different path depth than the
    // wildcard rule above, so it never inherits that rule's write access). The owner
    // may read their own status; only server-side code (Admin SDK, which bypasses
    // rules entirely) may ever set isPro — the client can never grant itself Pro.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
